	Поля = СтрРазделить(ТекСтрк, "|", Истина);	
	                                               

	ШК = Поля[0];
	Номенклатура = Поля[1];
	Характ = Поля[2];
	ПоУмолчанию = Поля[3];                  
	
 	Если Номенклатура <> "" Тогда        
		Попытка
			уид = Новый УникальныйИдентификатор(Номенклатура);
			_Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(уид);
		Исключение
		    Возврат;
		КонецПопытки;
	КонецЕсли;
	Если Характ <> "" Тогда
		Попытка
			уид = Новый УникальныйИдентификатор(Характ);
			_Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(уид);
		Исключение
		    Возврат;
		КонецПопытки;
	КонецЕсли;

	Если ТипЗнч(_Номенклатура) = Тип("СправочникСсылка.Номенклатура") и ЗначениеЗаполнено(_Номенклатура.ВерсияДанных) Тогда
		_Упаковка = _Номенклатура.ЕдиницаИзмерения;
	КонецЕсли;
			
	
	КодМаркировки0121 = КонвертироватьВКодМаркировки0121(ШК);
	
	ШтрихкодУпаковки = Справочники.ШтрихкодыУпаковокТоваров
		.НайтиПоРеквизиту("ЗначениеШтрихкода", КодМаркировки0121);
		
	Если Не ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда
			
		ШКОбъект = Справочники.ШтрихкодыУпаковокТоваров.СоздатьЭлемент();
		ШКОбъект.Номенклатура 			= _Номенклатура;
		ШКОбъект.Характеристика 		= _Характеристика;
		ШКОбъект.ЗначениеШтрихкода 		= КодМаркировки0121;
		ШКОбъект.ТипШтрихкода	 		= Перечисления.ТипыШтрихкодов.GS1_DataMatrix;
		ШКОбъект.ТипУпаковки 			= Перечисления.ТипыУпаковок.МаркированныйТовар;
		ШКОбъект.Упаковка				= _Упаковка;
		ШКОбъект.Записать();      
		
	КонецЕсли;   
											   
КонецПроцедуры

Функция КонвертироватьВКодМаркировки0121(Знач КодМаркировки)
	
	КодМаркировки0121 = КодМаркировки;
	
	Если СтрДлина(КодМаркировки) >= 27 Тогда
		Если СтрНачинаетсяС(КодМаркировки, "(01)") Тогда
			КодМаркировки0121 = КодМаркировки;
		ИначеЕсли СтрНачинаетсяС(КодМаркировки, "01") Тогда
			КодМаркировки0121 = "(01)" + Сред(КодМаркировки, 3, 14) + "(21)" + Сред(КодМаркировки, 19);
		Иначе
			КодМаркировки0121 = "(01)" + Сред(КодМаркировки, 1, 14) + "(21)" + Сред(КодМаркировки, 15);
		КонецЕсли;	
		
   КонецЕсли;
		
	Возврат КодМаркировки0121;

КонецФункции


