Процедура ЗагрузитьНаСервереИзМассиваАдресов_CSV(МассивАдресов)  Экспорт
    

	сч_обработано = 0;       
	сч_ошибок = 0;
	
	ЧтениеТекста = Новый ЧтениеТекста;
	
	НаборЗаписейШК = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьНаборЗаписей();
	НаборЗаписейДС = РегистрыСведений.КСП_ШтрихкодыПоУмолчанию.СоздатьНаборЗаписей();
	
	Для каждого Адрес Из МассивАдресов Цикл

		ДвоичныеДанные  = ПолучитьИзВременногоХранилища(Адрес);
		Если 1=0 Тогда
			ДвоичныеДанные = новый ДвоичныеДанные("");
		КонецЕсли;                                
		
		ИмяФайла = ПолучитьИмяВременногоФайла("csv");
		ДвоичныеДанные.Записать(ИмяФайла);
		
		
		ЧтениеТекста.Открыть(ИмяФайла);
		
		
		ТипСтрока = Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(200));
		ТипГУИД = Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36));
		Тип1 = Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(1));
		

		ТЗРекордсет = Новый ТаблицаЗначений;

		ТЗРекордсет.Колонки.Добавить("Штрихкод", ТипСтрока);
		ТЗРекордсет.Колонки.Добавить("Номенклатура", ТипГУИД);
		ТЗРекордсет.Колонки.Добавить("Характеристика", ТипГУИД);
		ТЗРекордсет.Колонки.Добавить("ПоУмолчанию", Тип1);
		
		ТекСтрк = ЧтениеТекста.ПрочитатьСтроку();
		Пока ТекСтрк <> Неопределено Цикл
			
			//Загрузить_ШК_из_CSV(ТекСтрк, НаборЗаписейШК, НаборЗаписейДС);
			
			
			Поля = СтрРазделить(ТекСтрк, "|", Истина);	
			                                               
     		новСтр = ТЗРекордсет.Добавить();
			новСтр.Штрихкод = Поля[0];
			новСтр.Номенклатура = Поля[1];
			новСтр.Характеристика = Поля[2];
			новСтр.ПоУмолчанию = Поля[3];    
			
			
			
			ТекСтрк = ЧтениеТекста.ПрочитатьСтроку();			
		КонецЦикла;

		Загрузить_ШК_из_CSV_Запрос_к_ТЗ(ТЗРекордсет, НаборЗаписейШК, НаборЗаписейДС);
		
	КонецЦикла;
	
	
	
КонецПроцедуры



// Описание_метода
//
// Параметры:
//	Параметр1 	- Тип1 - 
//
Процедура Загрузить_ШК_из_CSV(ТекСтрк, НаборЗаписейШК, НаборЗаписейДС)

	
	Поля = СтрРазделить(ТекСтрк, "|", Истина);	
	                                               

	ШК = Поля[0];
	Номенклатура = Поля[1];
	Характ = Поля[2];
	ПоУмолчанию = Поля[3];                  
	
		
		НаборЗаписейШК.Отбор.Штрихкод.Установить(ШК);
		
		////ЕНС. пока не перезаписываем существующие
		НаборЗаписейШК.Прочитать();                 
		НаборЗаписейШК.очистить();
		//Если НаборЗаписей.количество() > 0 Тогда
		//	Возврат Неопределено;
		//КонецЕсли;
		
		НовСтр = НаборЗаписейШК.Добавить();
		
		НовСтр.Штрихкод = ШК;               
		Если Номенклатура <> "" Тогда        
			Попытка
				уид = Новый УникальныйИдентификатор(Номенклатура);
				НовСтр.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(уид);
			Исключение
			    Возврат;
			КонецПопытки;
		КонецЕсли;
		Если Характ <> "" Тогда
			Попытка
				уид = Новый УникальныйИдентификатор(Характ);
				НовСтр.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(уид);
			Исключение
			    Возврат;
			КонецПопытки;
		КонецЕсли;

		Если ТипЗнч(НовСтр.Номенклатура) = Тип("СправочникСсылка.Номенклатура") и ЗначениеЗаполнено(НовСтр.Номенклатура.ВерсияДанных) Тогда
			НовСтр.Упаковка = НовСтр.Номенклатура.ЕдиницаИзмерения;
		КонецЕсли;
		
		
		
		НаборЗаписейШК.Записать();                   
		
		
		
		//-------------------------
		
		
		НаборЗаписейДС.Отбор.Штрихкод.Установить(ШК);
		
		НаборЗаписейДС.Прочитать();                 
		НаборЗаписейДС.очистить();
		
		НовСтр = НаборЗаписейДС.Добавить();
		
		НовСтр.Штрихкод = ШК;
		НовСтр.ПоУмолчанию = ?(ПоУмолчанию = "1", Истина, Ложь);
		
		
		НаборЗаписейДС.Записать();
		
		
												   
КонецПроцедуры


Процедура Загрузить_ШК_из_CSV_Запрос_к_ТЗ(ТЗРекордсет, НаборЗаписейШК, НаборЗаписейДС)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗ.Штрихкод КАК Штрихкод,
		|	ТЗ.Номенклатура КАК Номенклатура,
		|	ТЗ.Характеристика КАК Характеристика,
		|	ТЗ.ПоУмолчанию КАК ПоУмолчанию
		|ПОМЕСТИТЬ ВТ1
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ1.Штрихкод КАК Штрихкод,
		|	ВТ1.Номенклатура КАК Номенклатура,
		|	ВТ1.Характеристика КАК Характеристика,
		|	ВТ1.ПоУмолчанию КАК ПоУмолчанию
		|ИЗ
		|	ВТ1 КАК ВТ1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		|		ПО (ШтрихкодыНоменклатуры.Штрихкод = ВТ1.Штрихкод)
		|ГДЕ
		|	ШтрихкодыНоменклатуры.Штрихкод ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("ТЗ", ТЗРекордсет);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();       //     РезультатЗапроса.выгрузить()
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		// Вставить обработку выборки ВыборкаДетальныеЗаписи
	
		
		НаборЗаписейШК.Отбор.Штрихкод.Установить(ВыборкаДетальныеЗаписи.Штрихкод);

		НовСтр = НаборЗаписейШК.Добавить();
		
		НовСтр.Штрихкод = ВыборкаДетальныеЗаписи.Штрихкод;               
		Если ВыборкаДетальныеЗаписи.Номенклатура <> "" Тогда        
			Попытка
				уид = Новый УникальныйИдентификатор(ВыборкаДетальныеЗаписи.Номенклатура);
				НовСтр.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(уид);
			Исключение
			    Возврат;
			КонецПопытки;
		КонецЕсли;
		Если ВыборкаДетальныеЗаписи.Характеристика <> "" Тогда
			Попытка
				уид = Новый УникальныйИдентификатор(ВыборкаДетальныеЗаписи.Характеристика);
				НовСтр.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(уид);
			Исключение
			    Возврат;
			КонецПопытки;
		КонецЕсли;

		Если ТипЗнч(НовСтр.Номенклатура) = Тип("СправочникСсылка.Номенклатура") и ЗначениеЗаполнено(НовСтр.Номенклатура.ВерсияДанных) Тогда
			НовСтр.Упаковка = НовСтр.Номенклатура.ЕдиницаИзмерения;
		КонецЕсли;
		
		
		
		НаборЗаписейШК.Записать(Истина);                   
		НаборЗаписейШК.очистить();
		
		
		//-------------------------
		
		
		НаборЗаписейДС.Отбор.Штрихкод.Установить(ВыборкаДетальныеЗаписи.Штрихкод);

		НовСтр = НаборЗаписейДС.Добавить();
		
		НовСтр.Штрихкод = ВыборкаДетальныеЗаписи.Штрихкод;
		НовСтр.ПоУмолчанию = ?(ВыборкаДетальныеЗаписи.ПоУмолчанию = "1", Истина, Ложь);
		
		
		НаборЗаписейДС.Записать();
		НаборЗаписейДС.очистить();
		
	КонецЦикла;
	
												   
КонецПроцедуры



